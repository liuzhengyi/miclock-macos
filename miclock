#!/bin/zsh

# Managed CLI bridge for MicLock 3. The native app owns CoreAudio operations;
# this wrapper preserves the convenient mic-* command names.
set -u

readonly app="${MICLOCK_APP_PATH:-$HOME/Applications/MicLock.app}/Contents/MacOS/MicLock"
[[ -x "$app" ]] || {
  /usr/bin/printf 'MicLock is not installed: %s\n' "$app" >&2
  exit 127
}
exec "$app" --cli "${0:t}" "$@"

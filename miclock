#!/bin/zsh

set -u

readonly LABEL="com.user.mic-input-lock"
readonly USER_ID="$(/usr/bin/id -u)"
readonly SERVICE="gui/$USER_ID/$LABEL"
readonly PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
readonly SCRIPT="$HOME/.local/libexec/mic-input-lock/mic-input-lock.sh"
readonly CONFIG_DIR="$HOME/.config/mic-input-lock"
readonly DEVICE_FILE="$CONFIG_DIR/device-name"
readonly LOG_FILE="$HOME/Library/Logs/mic-input-lock.log"
readonly ERROR_LOG="$HOME/Library/Logs/mic-input-lock.error.log"

switch_audio_source="$(command -v SwitchAudioSource 2>/dev/null || true)"
if [[ -z "$switch_audio_source" ]]; then
  for candidate in \
    "$HOME/Applications/MicLock.app/Contents/Resources/bin/SwitchAudioSource" \
    /Applications/MicLock.app/Contents/Resources/bin/SwitchAudioSource \
    /opt/homebrew/opt/switchaudio-osx/SwitchAudioSource \
    /opt/homebrew/bin/SwitchAudioSource \
    /usr/local/bin/SwitchAudioSource; do
    if [[ -x "$candidate" ]]; then
      switch_audio_source="$candidate"
      break
    fi
  done
fi

die() {
  /bin/echo "错误：$*" >&2
  exit 1
}

require_installation() {
  [[ -f "$PLIST" && -x "$SCRIPT" ]] || die "麦克风锁定服务尚未安装"
  [[ -x "$switch_audio_source" ]] || die "找不到 SwitchAudioSource"
}

is_loaded() {
  /bin/launchctl print "$SERVICE" >/dev/null 2>&1
}

configured_device() {
  if [[ -r "$DEVICE_FILE" ]]; then
    /usr/bin/head -n 1 "$DEVICE_FILE"
  else
    /bin/echo "<未配置>"
  fi
}

cmd_status() {
  local state current target
  target="$(configured_device)"
  current="<不可用>"
  if [[ -x "$switch_audio_source" ]]; then
    current="$($switch_audio_source -c -t input 2>/dev/null || /bin/echo '<不可用>')"
  fi

  if is_loaded; then
    state="运行中"
  elif [[ -f "$PLIST" ]]; then
    state="已暂停"
  else
    state="未安装"
  fi

  /bin/echo "服务状态：$state"
  /bin/echo "锁定目标：$target"
  /bin/echo "当前输入：$current"
}

cmd_on() {
  require_installation
  /bin/launchctl enable "$SERVICE"
  if ! is_loaded; then
    /bin/launchctl bootstrap "gui/$USER_ID" "$PLIST"
  fi
  /bin/launchctl kickstart -k "$SERVICE"
  "$SCRIPT" --once >/dev/null
  /bin/echo "麦克风自动锁定已启用。"
  cmd_status
}

cmd_off() {
  [[ -f "$PLIST" ]] || die "麦克风锁定服务尚未安装"
  /bin/launchctl bootout "gui/$USER_ID" "$PLIST" 2>/dev/null || true
  /bin/launchctl disable "$SERVICE"
  /bin/echo "麦克风自动锁定已暂停；配置仍然保留。"
  cmd_status
}

cmd_fix() {
  require_installation
  "$SCRIPT" --once
  cmd_status
}

cmd_list() {
  [[ -x "$switch_audio_source" ]] || die "找不到 SwitchAudioSource"
  /bin/echo "可用输入设备："
  "$switch_audio_source" -a -t input
}

cmd_use() {
  local requested found device
  require_installation
  requested="${1:-}"
  [[ -n "$requested" ]] || die "用法：miclock use \"设备名称\""

  found=0
  while IFS= read -r device; do
    if [[ "$device" == "$requested" ]]; then
      found=1
      break
    fi
  done < <("$switch_audio_source" -a -t input)
  (( found )) || die "没有找到输入设备：$requested；请先运行 mic-list"

  /bin/echo "$requested" > "$DEVICE_FILE"
  /bin/chmod 600 "$DEVICE_FILE"
  if is_loaded; then
    /bin/launchctl kickstart -k "$SERVICE"
  fi
  "$SCRIPT" --once >/dev/null
  /bin/echo "锁定目标已改为：$requested"
  cmd_status
}

cmd_pick() {
  local devices device index choice
  [[ -x "$switch_audio_source" ]] || die "找不到 SwitchAudioSource"
  devices=()
  while IFS= read -r device; do
    [[ -n "$device" ]] && devices+=("$device")
  done < <("$switch_audio_source" -a -t input)
  (( ${#devices[@]} > 0 )) || die "当前没有可用的输入设备"

  /bin/echo "请选择默认麦克风："
  index=1
  for device in "${devices[@]}"; do
    /bin/echo "  $index) $device"
    (( index++ ))
  done
  /bin/echo -n "输入编号 [1-${#devices[@]}]: "
  read -r choice
  [[ "$choice" =~ '^[0-9]+$' ]] || die "请输入设备编号"
  (( choice >= 1 && choice <= ${#devices[@]} )) || die "设备编号超出范围"
  cmd_use "${devices[$choice]}"
}

cmd_logs() {
  local lines
  lines="${1:-30}"
  [[ "$lines" =~ '^[1-9][0-9]*$' ]] || die "日志行数必须是正整数"
  /bin/echo "--- $LOG_FILE"
  [[ -f "$LOG_FILE" ]] && /usr/bin/tail -n "$lines" "$LOG_FILE" || /bin/echo "暂无日志"
  /bin/echo "--- $ERROR_LOG"
  [[ -f "$ERROR_LOG" ]] && /usr/bin/tail -n "$lines" "$ERROR_LOG" || /bin/echo "暂无错误日志"
}

usage() {
  /bin/cat <<'EOF'
用法：miclock <命令>

  status              查看服务、目标和当前输入
  on                  启用自动锁定
  off                 暂停自动锁定（不卸载）
  fix                 立即纠正一次
  list                列出所有输入设备
  use "设备名称"      修改锁定目标
  pick                通过编号选择默认麦克风
  logs [行数]         查看日志，默认 30 行
  help                显示帮助

快捷命令：
  mic-pick                     通过编号选择并锁定默认麦克风
  mic-set "设备名称"           指定并锁定默认麦克风
  mic-quit                     停止程序，恢复 macOS 原本行为
  mic-start                    重新启动自动锁定
  mic-status、mic-list、mic-fix
EOF
}

case "${0:t}" in
  mic-on)     command_name="on" ;;
  mic-off)    command_name="off" ;;
  mic-status) command_name="status" ;;
  mic-list)   command_name="list" ;;
  mic-fix)    command_name="fix" ;;
  mic-pick)   command_name="pick" ;;
  mic-set)    command_name="use" ;;
  mic-quit)   command_name="off" ;;
  mic-start)  command_name="on" ;;
  *)          command_name="${1:-status}"; (( $# > 0 )) && shift ;;
esac

case "$command_name" in
  status) cmd_status ;;
  on)     cmd_on ;;
  off)    cmd_off ;;
  fix)    cmd_fix ;;
  list)   cmd_list ;;
  use)    cmd_use "${1:-}" ;;
  pick)   cmd_pick ;;
  logs)   cmd_logs "${1:-30}" ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
